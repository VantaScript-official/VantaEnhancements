local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- (1) AC 함수 사전 캡처 및 무력화 (getgc 후킹 전에 먼저)
local acTargets = {}
for _, v in getgc() do
    if typeof(v) == "function" then
        local src = debug.info(v, "s")
        if src and (src:find("LocalScript3") or src:find("MiscellaneousController") or src:find("AnalyticsPipelineController")) then
            table.insert(acTargets, v)
        end
    end
end
for _, v in acTargets do
    hookfunction(v, newcclosure(function()
        return task.wait(9e9)
    end))
end

-- (2) getgc 후킹 (AC 함수 은닉)
local oldGetGC = getgc
getgc = newcclosure(function(...)
    local gc = oldGetGC(...)
    local filtered = {}
    for _, v in ipairs(gc) do
        if typeof(v) == "function" then
            local src = debug.info(v, "s")
            if not (src and (src:find("LocalScript3") or src:find("MiscellaneousController") or src:find("AnalyticsPipelineController"))) then
                table.insert(filtered, v)
            end
        else
            table.insert(filtered, v)
        end
    end
    return filtered
end)

-- (3) 메타테이블 파괴 (GC 약한 참조 탐지 우회)
local mtHook
mtHook = hookfunction(getrenv().setmetatable, newcclosure(function(t, mt)
    if mt and type(mt) == "table" and rawget(mt, "__mode") then
        local trace = debug.traceback()
        if trace:find("MiscellaneousController") or trace:find("CameraSecurity") or trace:find("LocalScript3") then
            return mtHook({1, 2, 3}, {})
        end
    end
    return mtHook(t, mt)
end))

-- (4) 킥(Kick) 차단
local oldKick = lp.Kick
hookfunction(oldKick, newcclosure(function(self, ...)
    if self == lp then return end
    return oldKick(self, ...)
end))

-- (5) print/warn 무력화 (error는 건드리지 않음)
local oldPrint = print
local oldWarn = warn
print = function() end
warn = function() end

