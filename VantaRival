local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- 1. 킥(Kick) 함수 차단 (필수)
local oldKick = lp.Kick
hookfunction(oldKick, newcclosure(function(self, ...)
    if self == lp then return end
    return oldKick(self, ...)
end))

-- 2. AC 메인 루프만 무력화 (getgc 후킹 없이, 직접 함수를 찾아서 슬립)
-- getgc를 그대로 두어 Vanta가 자유롭게 함수를 찾을 수 있도록 함
local acTargets = {}
for _, v in getgc() do
    if typeof(v) == "function" then
        local src = debug.info(v, "s")
        if src and (src:find("LocalScript3") or src:find("MiscellaneousController") or src:find("AnalyticsPipelineController")) then
            table.insert(acTargets, v)
        end
    end
end
for _, v in acTargets do
    hookfunction(v, newcclosure(function()
        return task.wait(9e9)
    end))
end

-- 3. print/warn 무력화 (선택, 로그 정리용)
local oldPrint = print
local oldWarn = warn
print = function() end
warn = function() end

